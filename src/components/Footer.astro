---
import { localeFromPath, pathForLocale } from "../i18n";
import ArgusLogo from "./ArgusLogo.astro";
import { desktopRelease } from "../data/desktopRelease";
import { siteUpdatedAt } from "../data/siteBuild";
import { websiteMaintainer } from "../data/team";

const locale = localeFromPath(Astro.url.pathname);
const copy = locale === "zh" ? {
  home: "Argus 首页",
  tagline: "灯熄了，研究继续。",
  nav: "探索 Argus",
  resources: "资料与下载",
  download: "获取桌面版",
  report: "技术报告",
  demo: "视频演示",
  code: "GitHub 仓库",
  team: "Argus AI 团队",
  updated: "网站最近更新",
  creator: "网站制作：",
  websiteContact: "网站相关问题请联系",
  links: ["项目", "成绩", "研究", "原理", "场景", "演示", "联系我们", "开始使用"],
} : {
  home: "Argus home",
  tagline: "The lights go out. The research keeps moving.",
  nav: "Explore Argus",
  resources: "Resources",
  download: "Get the desktop app",
  report: "Technical report",
  demo: "Video demo",
  code: "GitHub",
  team: "Argus AI Team",
  updated: "Website last updated",
  creator: "Website by",
  websiteContact: "For website issues, contact",
  links: ["Projects", "Results", "Research", "How it works", "Use cases", "Demo", "Contact", "Get started"],
};
const localized = (href: string) => pathForLocale(href, locale);
const updatedLabel = new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : "en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "Asia/Shanghai",
  hourCycle: "h23",
}).format(new Date(siteUpdatedAt));
const resources = [
  { label: copy.report, href: "https://arxiv.org/abs/2608.05144" },
  { label: copy.demo, href: "https://www.youtube.com/watch?v=i8Qy9HCboQE" },
  { label: copy.code, href: "https://github.com/lbx154/Argus" },
  { label: copy.team, href: "https://github.com/Argus-AiTeam" },
];
---

<footer class="site-footer">
  <div class="footer-identity">
    <a class="footer-brand" href={localized("/")} aria-label={copy.home}>
      <ArgusLogo variant="horizontal" class="argus-logo--footer" decorative />
    </a>
    <p>{copy.tagline}</p>
  </div>
  <div class="footer-navs">
    <nav aria-labelledby="footer-explore-heading">
      <h2 class="footer-heading" id="footer-explore-heading">{copy.nav}</h2>
      <div class="footer-menu">
        <a href={localized("/projects/")}>{copy.links[0]}</a>
        <a href={localized("/results/")}>{copy.links[1]}</a>
        <a href={localized("/research/")}>{copy.links[2]}</a>
        <a href={localized("/how/")}>{copy.links[3]}</a>
        <a href={localized("/use-cases/")}>{copy.links[4]}</a>
        <a href={localized("/start/")}>{copy.links[5]}</a>
        <a href={localized("/contact/")}>{copy.links[6]}</a>
        <a href={localized("/get-started/")}>{copy.links[7]}</a>
      </div>
    </nav>
    <nav class="footer-resources" aria-labelledby="footer-resources-heading">
      <h2 class="footer-heading" id="footer-resources-heading">{copy.resources}</h2>
      <a class="footer-download" href={`${localized("/get-started/")}#desktop-download`}>
        <span>{copy.download}<small>{desktopRelease.platforms} · v{desktopRelease.version}</small></span>
        <span class="footer-arrow" aria-hidden="true">↓</span>
      </a>
      <div class="footer-resource-links">
        {resources.map((resource) => (
          <a href={resource.href} target="_blank" rel="noopener noreferrer">
            <span>{resource.label}</span><span class="footer-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </nav>
  </div>
  <div class="footer-meta">
    <p class="footer-updated">
      <span>{copy.updated}</span>
      <time datetime={siteUpdatedAt}>{updatedLabel} (UTC+8)</time>
    </p>
    <p class="footer-credit">
      <span>{copy.creator} {websiteMaintainer.name}</span>
      <span>
        {copy.websiteContact}
        <a class="footer-contact" href={`mailto:${websiteMaintainer.email}`}>{websiteMaintainer.email}</a>
      </span>
    </p>
  </div>
</footer>
