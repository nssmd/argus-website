---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import PixelIllustration from "../components/PixelIllustration";
import { desktopRelease } from "../data/desktopRelease";
import { localeFromPath, pathForLocale } from "../i18n";

const locale = localeFromPath(Astro.url.pathname);
const href = (path: string) => pathForLocale(path, locale);
const installGuide = "https://github.com/lbx154/Argus/blob/main/docs/agent-install.md";
const backendGuide = "https://github.com/lbx154/Argus/blob/main/docs/backend-providers.md";
const pluginGuide = "https://github.com/lbx154/Argus/blob/main/docs/plugin.md";
const copy = locale === "zh" ? {
  title: "开始使用 · Argus",
  description: "选择已有 Agent CLI，安装并验证 Argus，然后启动第一次经过独立 Reviewer 验收的长程任务。",
  eyebrow: "Argus · Get Started",
  hero: "沿用你已经在用的 Agent CLI。",
  lede: "Argus 不要求新的模型账户。让 Copilot、Codex、Claude、Pi 或其他受支持的 CLI 成为执行后端，再由 Manager、Planner、Engineer 与 Reviewer 接管长程工作。",
  download: "下载 Windows 安装程序",
  desktopTitle: "Windows 桌面版，一键安装。",
  desktopBody: `Argus ${desktopRelease.version} 改善了输入框稳定性、后端认证与恢复、首次 CLI 配置和 PDF 阅读体验。安装后即可连接已有的 Agent CLI，启动和查看长程任务。`,
  desktopRequirements: "需要 Microsoft Edge WebView2 Runtime 和已安装、已登录的受支持 Agent CLI。安装包已包含 Python 后端，无需另装 Python。",
  desktopUpgrade: "安装或升级前，请先停止正在进行的 Argus 任务并退出桌面端。",
  desktopSignatureNote: ".exe.sig 用于更新器验签，不是 Windows Authenticode 证书签名；Windows 仍可能提示未知发布者。",
  desktopAction: `下载 Argus ${desktopRelease.version}`,
  checksum: "SHA-256 校验值",
  releaseNotes: "查看 Release Notes",
  signature: "下载签名",
  assisted: "推荐：让 Agent 帮你安装",
  assistedBody: "把下面的提示词发送给当前正在使用的 Code Agent。它会读取与你的操作系统对应的安装契约，完成安装、配置和真实 smoke test，并在需要登录、sudo 或全局修改前征求确认。",
  copy: "复制提示词",
  copied: "已复制",
  prompt: "阅读 https://github.com/lbx154/Argus/blob/main/docs/agent-install.md，并使用其中适合当前操作系统的章节安装 Argus。优先使用正在进行本次对话的 Agent CLI 作为 Argus 后端。完成真实 Agent-turn smoke test，然后运行 `argus doctor --deep --advisor auto`。在登录账户、使用 sudo 或修改全局配置前，说明原因并等待确认。不要要求我在对话中粘贴密码、Token 或 API Key。",
  platformsTitle: "选择你的平台",
  platformsBody: "Windows 用户可以直接安装桌面版；macOS、Linux 与需要源码环境的高级用户可使用对应的命令行安装方式。所有平台都需要一个已登录的 Agent CLI。",
  platforms: [
    ["Windows 10/11", "Desktop installer", "推荐使用上方的一键桌面安装程序；需要源码环境时也可按安装指南使用 Python 直接安装。"],
    ["macOS", "Managed uv tool", "由 uv 管理独立环境，无需手工创建 venv；适合 Apple Silicon 与日常桌面使用。"],
    ["Linux", "Isolated source venv", "在明确的 venv 中保留 Python、CUDA 工具和长期进程的可复现所有权。"],
  ],
  openGuide: "打开对应安装步骤 ↗",
  firstTitle: "第一次运行",
  firstBody: "安装完成后，按顺序配置后端、让 doctor 主动修复环境，再进入 cockpit。首次真实运行应通过 status 和 Reviewer 结果确认，而不是只看命令是否存在。",
  steps: [
    ["01", "确认版本", "argus --version"],
    ["02", "配置后端", "argus --setup"],
    ["03", "检查并修复", "argus doctor --deep --advisor auto"],
    ["04", "确认状态", "argus --status"],
    ["05", "进入 cockpit", "argus"],
  ],
  backendsTitle: "九个原生后端，共用一个 Argus Runtime",
  backendsBody: "桌面版与当前源码版均可直接驱动九种 Agent CLI。Argus 负责组织、记忆、执行与独立验收；实际推理由你选择并已登录的 CLI 提供。",
  backendReleaseNote: `版本说明：Windows ${desktopRelease.version} 已包含 Cursor CLI 后端支持。Agent CLI 本身仍需单独安装并登录，不随 Argus 安装包提供。`,
  backends: [
    ["GitHub Copilot CLI", "copilot", "使用已登录的 GitHub Copilot 会话"],
    ["OpenAI Codex CLI", "codex", "沿用 Codex 自己的模型目录与登录"],
    ["Claude Code", "claude", "沿用 Claude Code 登录与模型选择"],
    ["Cursor CLI", "cursor", "支持 agent login 或 CURSOR_API_KEY"],
    ["Pi", "pi", "可连接多个 Provider 的模型目录"],
    ["OpenCode", "opencode", "按 Provider 与模型 ID 选择"],
    ["xAI Grok Build", "grok", "支持 grok login 或 XAI_API_KEY"],
    ["Qoder CLI", "qoder", "支持浏览器登录或 Personal Access Token"],
    ["DeepSeek Harness", "dsh", "通过 DeepSeek 的 Headless Runner 执行"],
  ],
  backendGuide: "查看后端、Provider 与模型配置",
  linksTitle: "接下来去哪里",
  report: "阅读 Argus 技术报告",
  demo: "观看四条真实运行",
  plugin: "接入现有 Coding Agent",
  code: "查看 Preview 仓库",
  official: "查看官方发行仓库",
  helpTitle: "遇到问题时，先保留诊断证据。",
  helpBody: "运行 doctor，记录平台、Argus 版本、后端名称和失败阶段，再到 GitHub 提交可复现的问题。",
  issues: "打开 GitHub Issues ↗",
} : {
  title: "Get Started · Argus",
  description: "Reuse an Agent CLI you already trust, install and verify Argus, and launch a first long-horizon task with independent review.",
  eyebrow: "Argus · Get Started",
  hero: "Bring the Agent CLI you already use.",
  lede: "Argus does not require another model account. Use Copilot, Codex, Claude, Pi, or another supported CLI as the execution backend, then let the Manager, Planner, Engineer, and Reviewer sustain the work.",
  download: "Download the Windows installer",
  desktopTitle: "Argus Desktop for Windows, ready in one download.",
  desktopBody: `Argus ${desktopRelease.version} improves input stability, backend authentication and recovery, first-run CLI setup, and PDF reading. Connect an Agent CLI you already use to launch and inspect long-horizon work.`,
  desktopRequirements: "Requires Microsoft Edge WebView2 Runtime and a supported Agent CLI that is already installed and authenticated. The Python backend is bundled; no separate Python installation is needed.",
  desktopUpgrade: "Before installing or upgrading, stop any running Argus tasks and exit the desktop application.",
  desktopSignatureNote: ".exe.sig is an updater verification signature, not a Windows Authenticode certificate signature. Windows may still show an unknown-publisher warning.",
  desktopAction: `Download Argus ${desktopRelease.version}`,
  checksum: "SHA-256 checksum",
  releaseNotes: "View release notes",
  signature: "Download signature",
  assisted: "Recommended: let your Agent install it",
  assistedBody: "Send the prompt below to the Code Agent you are using now. It will read the installation contract for your operating system, install and configure Argus, run a real smoke test, and pause before login, sudo, or global configuration changes.",
  copy: "Copy prompt",
  copied: "Copied",
  prompt: "Read https://github.com/lbx154/Argus/blob/main/docs/agent-install.md and install Argus using the section for this operating system. Prefer the Agent CLI running this conversation as the Argus backend. Run setup through its real Agent-turn smoke test, then run `argus doctor --deep --advisor auto`. Before account login, sudo, or global configuration changes, explain why and wait for approval. Never ask me to paste a password, token, or API key into the conversation.",
  platformsTitle: "Choose your platform",
  platformsBody: "Windows users can install the desktop application directly. macOS, Linux, and advanced users who need a source environment can follow the corresponding command-line path. Every platform needs one authenticated Agent CLI.",
  platforms: [
    ["Windows 10/11", "Desktop installer", "Use the one-click desktop installer above, or follow the installation guide for a direct Python setup when you need a source environment."],
    ["macOS", "Managed uv tool", "Let uv own the isolated environment instead of creating a venv manually. This is the clean desktop path for Apple Silicon."],
    ["Linux", "Isolated source venv", "Keep Python, CUDA tooling, and long-running process ownership reproducible inside an explicit venv."],
  ],
  openGuide: "Open the platform instructions ↗",
  firstTitle: "Your first run",
  firstBody: "After installation, configure the backend, let doctor actively repair the environment, and enter the cockpit. Confirm the first real run through status and Reviewer evidence—not only the presence of a command.",
  steps: [
    ["01", "Confirm version", "argus --version"],
    ["02", "Configure backend", "argus --setup"],
    ["03", "Inspect and repair", "argus doctor --deep --advisor auto"],
    ["04", "Confirm status", "argus --status"],
    ["05", "Enter the cockpit", "argus"],
  ],
  backendsTitle: "Nine native backends. One Argus runtime.",
  backendsBody: "The desktop and current source builds drive nine Agent CLIs directly. Argus provides organization, memory, execution, and independent review; the authenticated CLI you select provides model inference.",
  backendReleaseNote: `Version note: Windows ${desktopRelease.version} includes Cursor CLI backend support. Agent CLIs must still be installed and authenticated separately; they are not bundled with Argus.`,
  backends: [
    ["GitHub Copilot CLI", "copilot", "Uses your authenticated GitHub Copilot session"],
    ["OpenAI Codex CLI", "codex", "Keeps Codex's native catalog and authentication"],
    ["Claude Code", "claude", "Keeps Claude Code authentication and model selection"],
    ["Cursor CLI", "cursor", "Supports agent login or CURSOR_API_KEY"],
    ["Pi", "pi", "Resolves models across multiple provider catalogs"],
    ["OpenCode", "opencode", "Selects a provider-qualified model ID"],
    ["xAI Grok Build", "grok", "Supports grok login or XAI_API_KEY"],
    ["Qoder CLI", "qoder", "Supports browser login or a Personal Access Token"],
    ["DeepSeek Harness", "dsh", "Runs through DeepSeek's headless runner"],
  ],
  backendGuide: "Open backend, provider, and model setup",
  linksTitle: "Where to go next",
  report: "Read the Argus technical report",
  demo: "Watch four real runs",
  plugin: "Connect an existing Coding Agent",
  code: "Open the preview repository",
  official: "Open the official release",
  helpTitle: "When something fails, preserve the diagnostic evidence.",
  helpBody: "Run doctor, record the platform, Argus version, backend name, and failing stage, then open a reproducible GitHub issue.",
  issues: "Open GitHub Issues ↗",
};
---

<SiteLayout title={copy.title} description={copy.description}>
  <PageHero scene="trailhead" class="onboarding-hero" shellClass="onboarding-shell">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.hero}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="hero-actions">
        <a class="button primary" href={desktopRelease.downloadUrl}>{copy.download} ↓</a>
        <a class="button" href="#agent-install">{copy.assisted}</a>
        <a class="button" href={href("/start/")}>{copy.demo}</a>
      </div>
  </PageHero>

  <section id="windows-download" class="section desktop-download-section">
    <div class="shell onboarding-shell">
      <div class="desktop-download-card">
        <div class="desktop-download-card__copy">
          <p class="eyebrow">01 · Windows desktop</p>
          <h2>{copy.desktopTitle}</h2>
          <p>{copy.desktopBody}</p>
          <p>{copy.desktopRequirements}</p>
          <p><strong>{copy.desktopUpgrade}</strong></p>
          <div class="desktop-download-card__meta">
            <span>{desktopRelease.platform} · {desktopRelease.architecture} · {desktopRelease.size}</span>
            <span>Tauri 2</span>
          </div>
        </div>
        <div class="desktop-download-card__action">
          <a class="button primary" href={desktopRelease.downloadUrl}>{copy.desktopAction} ↓</a>
          <div class="desktop-download-card__links">
            <a href={desktopRelease.releaseUrl} target="_blank" rel="noopener noreferrer">{copy.releaseNotes} ↗</a>
            <a href={desktopRelease.signatureUrl}>{copy.signature} ↓</a>
          </div>
        </div>
        <div class="desktop-download-card__checksum">
          <span>{copy.checksum}</span>
          <code>{desktopRelease.sha256}</code>
          <p>{copy.desktopSignatureNote}</p>
        </div>
      </div>
    </div>
  </section>

  <section id="agent-install" class="section">
    <div class="shell onboarding-shell">
      <div class="section-head">
        <p class="eyebrow">02 · Agent-assisted</p>
        <h2>{copy.assisted}</h2>
        <p>{copy.assistedBody}</p>
        <PixelIllustration scene="field-kit" />
      </div>
      <div class="agent-install-card">
        <pre id="agent-install-prompt"><code>{copy.prompt}</code></pre>
        <button class="copy-button" type="button" data-copy-target="agent-install-prompt" data-copy-label={copy.copy} data-copied-label={copy.copied}>{copy.copy}</button>
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="shell onboarding-shell">
      <div class="section-head">
        <p class="eyebrow">03 · Platform</p>
        <h2>{copy.platformsTitle}</h2>
        <p>{copy.platformsBody}</p>
      </div>
      <div class="platform-grid">
        {copy.platforms.map(([name, method, body]) => (
          <article class="platform-card">
            <span>{method}</span>
            <h3>{name}</h3>
            <p>{body}</p>
            <a href={installGuide} target="_blank" rel="noopener noreferrer">{copy.openGuide}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell onboarding-shell">
      <div class="section-head">
        <p class="eyebrow">04 · First run</p>
        <h2>{copy.firstTitle}</h2>
        <p>{copy.firstBody}</p>
        <PixelIllustration scene="launch-dock" />
      </div>
      <div class="first-run-list">
        {copy.steps.map(([number, title, command]) => (
          <article>
            <span>{number}</span>
            <div><strong>{title}</strong><code>{command}</code></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="shell onboarding-shell">
      <div class="section-head">
        <p class="eyebrow">05 · Backends</p>
        <h2>{copy.backendsTitle}</h2>
        <p>{copy.backendsBody}</p>
        <PixelIllustration scene="relay-bridge" />
      </div>
      <div class="backend-grid">
        {copy.backends.map(([name, id, detail], index) => (
          <article class={`backend-card${id === "cursor" ? " backend-card--new" : ""}`}>
            <div class="backend-card__head">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <code>{id}</code>
            </div>
            <h3>{name}</h3>
            <p>{detail}</p>
            {id === "cursor" && <strong>NEW</strong>}
          </article>
        ))}
      </div>
      <div class="backend-version-note">
        <p>{copy.backendReleaseNote}</p>
        <a href={backendGuide} target="_blank" rel="noopener noreferrer">{copy.backendGuide} ↗</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell onboarding-shell">
      <div class="onboarding-links">
        <p class="eyebrow">{copy.linksTitle}</p>
        <div>
          <a href="https://arxiv.org/abs/2608.05144" target="_blank" rel="noopener noreferrer">{copy.report} ↗</a>
          <a href={href("/start/")}>{copy.demo} →</a>
          <a href={pluginGuide} target="_blank" rel="noopener noreferrer">{copy.plugin} ↗</a>
          <a href="https://github.com/lbx154/Argus" target="_blank" rel="noopener noreferrer">{copy.code} ↗</a>
          <a href="https://github.com/microsoft/ArgusAgent" target="_blank" rel="noopener noreferrer">{copy.official} ↗</a>
        </div>
      </div>
      <div class="cta-band onboarding-help">
        <h2>{copy.helpTitle}</h2>
        <p>{copy.helpBody}</p>
        <a class="button primary" href="https://github.com/microsoft/ArgusAgent/issues" target="_blank" rel="noopener noreferrer">{copy.issues}</a>
        <PixelIllustration scene="memory-garden" />
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  document.querySelectorAll("[data-copy-target]").forEach((element) => {
    if (!(element instanceof HTMLButtonElement)) return;
    element.addEventListener("click", async () => {
      const target = document.getElementById(element.dataset.copyTarget ?? "");
      if (!target) return;
      await navigator.clipboard.writeText(target.textContent?.trim() ?? "");
      element.textContent = element.dataset.copiedLabel ?? "Copied";
      window.setTimeout(() => {
        element.textContent = element.dataset.copyLabel ?? "Copy";
      }, 1800);
    });
  });
</script>
