---
import { localeFromPath, pathForLocale } from "../i18n";
import ArgusLogo from "./ArgusLogo.astro";

const path = Astro.url.pathname;
const locale = localeFromPath(path);
const copy = locale === "zh" ? {
  home: "Argus 首页",
  nav: "主导航",
  light: "切换到白天模式",
  dark: "切换到黑夜模式",
  start: "开始使用",
  github: "GitHub",
  menu: "打开导航",
  closeMenu: "收起导航",
  links: ["首页", "项目", "成绩", "研究", "原理", "演示", "联系我们"],
} : {
  home: "Argus home",
  nav: "Main navigation",
  light: "Switch to light mode",
  dark: "Switch to dark mode",
  start: "Get started",
  github: "GitHub",
  menu: "Open navigation",
  closeMenu: "Close navigation",
  links: ["Home", "Projects", "Results", "Research", "How it works", "Demo", "Contact"],
};
const links = [
  { href: "/", label: copy.links[0] },
  { href: "/projects/", label: copy.links[1] },
  { href: "/results/", label: copy.links[2] },
  { href: "/research/", label: copy.links[3] },
  { href: "/how/", label: copy.links[4] },
  { href: "/start/", label: copy.links[5] },
  { href: "/contact/", label: copy.links[6] },
];
const localized = (href: string) => pathForLocale(href, locale);
const currentBase = pathForLocale(path, "en");
const isCurrent = (href: string) => currentBase === href || (href === "/projects/" && currentBase.startsWith("/projects/"));
---

<header class="site-header">
  <div class="site-progress" data-scroll-progress aria-hidden="true"></div>
  <div class="site-header__inner">
    <a class="site-brand" href={localized("/")} aria-label={copy.home}>
      <ArgusLogo variant="horizontal" class="argus-logo--header" decorative />
    </a>
    <nav class="site-nav" id="site-navigation" aria-label={copy.nav}>
      {links.map((link) => (
        <a
          href={localized(link.href)}
          aria-current={isCurrent(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
      <a class="site-nav__github" href="https://github.com/Argus-AiTeam" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
    <div class="site-actions">
      <a class="site-action site-action--secondary" href="https://github.com/Argus-AiTeam" target="_blank" rel="noopener noreferrer">
        {copy.github}
        <span aria-hidden="true">↗</span>
      </a>
      <a class="site-action site-action--primary" href={localized("/get-started/")} aria-current={currentBase === "/get-started/" ? "page" : undefined}>{copy.start}</a>
    </div>
    <nav class="language-switcher" aria-label="Language">
      <a href={pathForLocale(path, "en")} hreflang="en" lang="en" data-language-switch aria-current={locale === "en" ? "page" : undefined}>EN</a>
      <span aria-hidden="true">/</span>
      <a href={pathForLocale(path, "zh")} hreflang="zh-Hans" lang="zh-CN" data-language-switch aria-current={locale === "zh" ? "page" : undefined}>中</a>
    </nav>
    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      data-label-light={copy.light}
      data-label-dark={copy.dark}
      aria-label={copy.dark}
      title={copy.dark}
    >
      <svg class="theme-icon theme-icon--moon" viewBox="0 0 20 20" aria-hidden="true">
        <path d="M16.2 12.8A7 7 0 0 1 7.2 3.8 7 7 0 1 0 16.2 12.8Z" />
      </svg>
      <svg class="theme-icon theme-icon--sun" viewBox="0 0 20 20" aria-hidden="true">
        <circle cx="10" cy="10" r="3.25" />
        <path d="M10 1.5v2M10 16.5v2M1.5 10h2M16.5 10h2M4 4l1.4 1.4M14.6 14.6 16 16M16 4l-1.4 1.4M5.4 14.6 4 16" />
      </svg>
    </button>
    <button class="site-menu-toggle" type="button" data-menu-toggle hidden
      aria-controls="site-navigation" aria-expanded="false" aria-label={copy.menu}
      data-label-open={copy.menu} data-label-close={copy.closeMenu}>
      <span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .site-menu-toggle, .site-nav__github { display: none; }
  .site-menu-toggle[hidden], .site-nav[hidden] { display: none !important; }
  @media (max-width: 1100px) {
    .site-header[data-menu-ready] .site-header__inner {
      min-height: 62px; width: 100%; padding: 10px 14px; gap: 8px; flex-wrap: nowrap;
    }
    .site-header[data-menu-ready] .site-brand { margin-right: auto; }
    .site-header[data-menu-ready] .theme-toggle { flex: 0 0 40px; width: 40px; height: 40px; }
    .site-header[data-menu-ready] .site-action--secondary { display: none; }
    .site-header[data-menu-ready] .site-nav {
      position: absolute; top: 100%; right: 14px; width: min(480px, calc(100% - 28px));
      display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin: 0; padding: 14px;
      background: var(--surface); border: 1px solid var(--line); border-radius: var(--panel-radius);
      overflow: visible;
    }
    .site-header[data-menu-ready] .site-nav a {
      display: flex; align-items: center; min-height: 44px; padding: 8px 12px; border-radius: var(--control-radius);
    }
    .site-header[data-menu-ready] .site-nav a:hover,
    .site-header[data-menu-ready] .site-nav a[aria-current="page"] { background: var(--blue-soft); color: var(--blue); }
    .site-menu-toggle {
      display: flex; flex: 0 0 40px; min-height: 40px; padding: 10px;
      flex-direction: column; align-items: center; justify-content: center; gap: 5px;
      color: var(--ink); background: transparent; border: 1px solid var(--line); border-radius: var(--control-radius); cursor: pointer;
    }
    .site-menu-toggle span { width: 17px; height: 1px; background: currentColor; transition: transform 160ms; }
    .site-menu-toggle[aria-expanded="true"] span:first-child { transform: translateY(3px) rotate(45deg); }
    .site-menu-toggle[aria-expanded="true"] span:last-child { transform: translateY(-3px) rotate(-45deg); }
  }
  @media (max-width: 360px) {
    .site-header[data-menu-ready] .site-header__inner { gap: 6px; }
    .site-header[data-menu-ready] .site-brand :global(.argus-logo--header) { width: 64px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const menu = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = header?.querySelector<HTMLElement>("#site-navigation");
  if (header && menu && nav) {
    const compact = window.matchMedia("(max-width: 1100px)");
    const setMenu = (open: boolean, restoreFocus = false) => {
      nav.hidden = compact.matches && !open;
      menu.setAttribute("aria-expanded", String(open));
      menu.setAttribute("aria-label", (open ? menu.dataset.labelClose : menu.dataset.labelOpen) ?? "");
      if (open) nav.querySelector<HTMLAnchorElement>('[aria-current="page"], a')?.focus();
      else if (restoreFocus) menu.focus();
    };
    const updateLayout = () => {
      const menuHadFocus = document.activeElement === menu;
      menu.hidden = !compact.matches;
      setMenu(false, compact.matches && nav.contains(document.activeElement));
      if (!compact.matches && menuHadFocus) nav.querySelector<HTMLAnchorElement>("a")?.focus();
    };
    header.dataset.menuReady = "true";
    updateLayout();
    menu.addEventListener("click", () => setMenu(menu.getAttribute("aria-expanded") !== "true"));
    compact.addEventListener("change", updateLayout);
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.getAttribute("aria-expanded") === "true") setMenu(false, true);
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setMenu(false);
    });
    header.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setMenu(false);
    });
    nav.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) setMenu(false);
    });
    const measureHeader = () => document.documentElement.style.setProperty(
      "--site-header-height", `${header.getBoundingClientRect().height}px`,
    );
    measureHeader();
    if (typeof ResizeObserver === "function") new ResizeObserver(measureHeader).observe(header);
    else window.addEventListener("resize", measureHeader, { passive: true });
  }
</script>

<script is:inline>
  if (!window.__argusLanguageSwitchReady) {
    window.__argusLanguageSwitchReady = true;
    document.addEventListener("click", (event) => {
      if (
        !(event instanceof MouseEvent) ||
        event.defaultPrevented ||
        event.button !== 0 ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      ) return;
      const link = event.target instanceof Element
        ? event.target.closest("[data-language-switch]")
        : null;
      if (!(link instanceof HTMLAnchorElement)) return;
      const target = new URL(link.href, window.location.href);
      target.search = window.location.search;
      target.hash = window.location.hash;
      if (target.pathname === window.location.pathname) {
        event.preventDefault();
        return;
      }
      event.preventDefault();
      try {
        sessionStorage.setItem("argus-language-switch", JSON.stringify({
          path: target.pathname,
          x: window.scrollX,
          y: window.scrollY,
          at: Date.now(),
        }));
        localStorage.setItem("argus-site-language", link.lang || "en");
      } catch {
        // The language still switches when browser storage is unavailable.
      }
      window.location.replace(target.href);
    });
  }
</script>

<script is:inline>
  const toggle = document.querySelector("[data-theme-toggle]");
  if (toggle instanceof HTMLButtonElement && toggle.dataset.ready !== "true") {
    toggle.dataset.ready = "true";
    const root = document.documentElement;
    const media = window.matchMedia("(prefers-color-scheme: dark)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let intendedTheme = root.dataset.theme === "dark" ? "dark" : "light";
    let themeTransition = null;
    const savedTheme = () => {
      try {
        return localStorage.getItem("argus-site-theme");
      } catch {
        return null;
      }
    };
    const apply = (theme) => {
      intendedTheme = theme;
      root.dataset.theme = theme;
      root.style.colorScheme = theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute(
        "content",
        theme === "dark" ? "#07101c" : "#ffffff",
      );
      const label = theme === "dark"
        ? toggle.dataset.labelLight
        : toggle.dataset.labelDark;
      if (label) {
        toggle.setAttribute("aria-label", label);
        toggle.title = label;
      }
    };
    apply(intendedTheme);
    toggle.addEventListener("click", () => {
      intendedTheme = intendedTheme === "dark" ? "light" : "dark";
      try {
        localStorage.setItem("argus-site-theme", intendedTheme);
      } catch {
        // Theme still applies for this page when persistence is unavailable.
      }
      themeTransition?.skipTransition();
      if (reducedMotion.matches || !document.startViewTransition) {
        apply(intendedTheme);
        return;
      }

      const rect = toggle.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const tile = 32;
      const height = Math.ceil(innerHeight / tile) * tile;
      const edge = [[0, 0]];
      for (let row = 0; row < height / tile; row++) {
        edge.push([row * tile, (row + 1) * tile], [(row + 1) * tile, (row + 1) * tile]);
      }
      edge.push([innerWidth + height, height], [innerWidth + height, 0]);
      root.style.setProperty("--theme-clip", `polygon(${edge.map(([dx, dy]) => `${dx}px ${dy}px`).join(",")})`);
      root.style.setProperty("--theme-shift-start", `${x - Math.floor(y / tile) * tile}px`);
      root.style.setProperty("--theme-shift-end", `${-height}px`);
      // Separate snapshots let a fixed mask move without moving the page content.
      root.dataset.themeTransition = "before";
      const transition = document.startViewTransition(() => {
        // A skipped callback must not rename a newer transition's snapshot.
        if (themeTransition !== transition) return;
        // Queued snapshots must use the latest intent, even without localStorage.
        apply(intendedTheme);
        root.dataset.themeTransition = "after";
        // Capture final palette colors without stopping transforms or the opening.
        document.getAnimations().forEach((animation) => {
          if (animation instanceof CSSTransition && (
            animation.transitionProperty.endsWith("color")
            || ["box-shadow", "text-shadow", "fill", "stroke"].includes(animation.transitionProperty)
          )) animation.finish();
        });
      });
      themeTransition = transition;
      transition.ready.catch((error) => {
        if (error.name !== "AbortError") console.warn("Theme animation was skipped:", error);
      });
      transition.finished.finally(() => {
        if (themeTransition !== transition) return;
        themeTransition = null;
        delete root.dataset.themeTransition;
        ["--theme-clip", "--theme-shift-start", "--theme-shift-end"]
          .forEach((property) => root.style.removeProperty(property));
      });
    });
    // Root snapshots receive pointer clicks instead of the underlying button.
    document.addEventListener("click", (event) => {
      if (!themeTransition || event.target !== root) return;
      const rect = toggle.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right
        || event.clientY < rect.top || event.clientY > rect.bottom) return;
      event.stopImmediatePropagation();
      toggle.focus({ preventScroll: true });
      toggle.click();
    }, true);
    reducedMotion.addEventListener("change", (event) => {
      if (event.matches) themeTransition?.skipTransition();
    });
    media.addEventListener("change", (event) => {
      if (!savedTheme()) {
        apply(event.matches ? "dark" : "light");
      }
    });
  }
</script>
