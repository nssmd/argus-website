---
type Scene =
  | "research-atlas"
  | "silicon-foundry"
  | "model-laboratory"
  | "control-room"
  | "geometry-garden"
  | "measurement-station"
  | "research-library"
  | "clockwork-workshop"
  | "trailhead"
  | "signal-theater"
  | "frontier-outpost"
  | "research-campus";
type Props = { scene: Scene; class?: string; shellClass?: string; copyClass?: string };
const { scene, class: className, shellClass, copyClass } = Astro.props;
---

<section class:list={["page-hero", "compact", "illustrated-hero", className]}>
  <div class:list={["shell", "illustrated-hero__grid", shellClass]}>
    <div class:list={["illustrated-hero__copy", copyClass]}><slot /></div>
    <img class="illustrated-hero__art" src={`/art/pixel/${scene}.svg`}
      width="320" height="180" alt="" data-page-scene={scene} />
  </div>
</section>

<style>
  .illustrated-hero { padding: 64px 0 54px; }
  .illustrated-hero__grid {
    display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    align-items: center; gap: 48px;
  }
  .illustrated-hero__copy { min-width: 0; }
  .illustrated-hero__copy :global(h1) { font-size: clamp(34px, 3.9vw, 54px); line-height: 1.16; text-wrap: balance; }
  .illustrated-hero__copy :global(.lede) { font-size: 17px; line-height: 1.8; }
  .illustrated-hero__art { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  :global(html:lang(zh-CN)) .illustrated-hero__copy :global(h1) { font-size: clamp(30px, 3.5vw, 48px); line-height: 1.3; }
  @media (max-width: 820px) {
    .illustrated-hero { padding: 34px 0 40px; }
    .illustrated-hero__grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .illustrated-hero__art { grid-row: 1; max-width: 420px; justify-self: center; }
  }
</style>
