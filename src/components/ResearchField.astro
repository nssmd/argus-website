---
type Props = { locale: "en" | "zh" };
const { locale } = Astro.props;
const zh = locale === "zh";
const fieldId = `research-roles-${locale}`;
const roles = [
  {
    id: "manager", letter: "M", name: "Manager", x: 55, y: 36,
    action: zh ? "统筹目标" : "Direct",
    description: zh
      ? "接收目标，确定任务领域与阶段，让后续工作始终围绕同一个目标展开。"
      : "Receives the objective, sets the domain and stage, and keeps the work aligned.",
    output: zh ? "明确范围的任务与阶段方向。" : "A scoped mission and stage direction.",
  },
  {
    id: "planner", letter: "P", name: "Planner", x: 25, y: 49,
    action: zh ? "规划下一步" : "Plan",
    description: zh
      ? "结合目标与已有证据，提出下一批值得推进、可以执行的任务。"
      : "Uses the objective and existing evidence to choose the next batch of actionable work.",
    output: zh ? "按优先级排列的待办任务。" : "An ordered backlog of next steps.",
  },
  {
    id: "engineer", letter: "E", name: "Engineer", x: 32, y: 70,
    action: zh ? "执行与产出" : "Build",
    description: zh
      ? "真正执行任务：阅读资料、编写代码、运行实验，留下可检查的结果。"
      : "Does the work: reads sources, writes code, and runs experiments with inspectable results.",
    output: zh ? "成果文件、实验结果与执行证据。" : "Artifacts, results, and execution evidence.",
  },
  {
    id: "reviewer", letter: "R", name: "Reviewer", x: 75, y: 73,
    action: zh ? "独立验收" : "Verify",
    description: zh
      ? "对照验收标准检查成果；证据不足时，给出具体的返工指引。"
      : "Checks artifacts against acceptance criteria and gives precise revision guidance when needed.",
    output: zh
      ? "完成、继续或阻塞的裁决，以及工作记忆检查点。"
      : "A done, continue, or blocked verdict and a working checkpoint.",
  },
];
---

<figure class="research-field" data-research-field>
  <fieldset class="research-field__explorer">
    <legend class="research-field__sr-only">{zh ? "探索 Argus 的四个角色" : "Explore the four Argus roles"}</legend>
    {roles.map((role, index) => (
      <input class="research-field__choice" type="radio" name={fieldId}
        id={`${fieldId}-${role.id}`} value={role.id} checked={index === 0}
        aria-labelledby={`${fieldId}-${role.id}-label`}
        aria-controls={`${fieldId}-${role.id}-detail`}
        aria-describedby={`${fieldId}-${role.id}-description ${fieldId}-${role.id}-output`} />
    ))}
    <div class="research-field__landscape">
      <img src="/art/pixel/night-observatory.svg" width="384" height="288" alt="" fetchpriority="low" />
      {roles.map((role) => (
        <label class="research-field__station" for={`${fieldId}-${role.id}`} data-role={role.id}
          style={`--station-x:${role.x}%;--station-y:${role.y}%`} title={`${role.name} · ${role.action}`}>
          <span aria-hidden="true">{role.letter}</span>
        </label>
      ))}
    </div>
    <div class="research-field__roles">
      {roles.map((role) => (
        <label class="research-field__node" for={`${fieldId}-${role.id}`} data-role={role.id}
          id={`${fieldId}-${role.id}-label`}>
          <span>{role.name}</span><small>{role.action}</small>
        </label>
      ))}
    </div>
    <div class="research-field__details">
      {roles.map((role, index) => (
        <section class="research-field__detail" data-role={role.id}
          id={`${fieldId}-${role.id}-detail`} aria-labelledby={`${fieldId}-${role.id}-title`}>
          <div class="research-field__detail-heading">
            <span class="research-field__index" aria-hidden="true">0{index + 1} / 04</span>
            <h3 id={`${fieldId}-${role.id}-title`}>{role.name}</h3>
            <span class="research-field__action">{role.action}</span>
          </div>
          <p id={`${fieldId}-${role.id}-description`}>{role.description}</p>
          <dl id={`${fieldId}-${role.id}-output`}>
            <dt>{zh ? "交付物" : "Deliverable"}</dt><dd>{role.output}</dd>
          </dl>
        </section>
      ))}
    </div>
  </fieldset>
  <figcaption>{zh
    ? "像素研究站 · 点选地标探索角色，并非实时运行画面。"
    : "The pixel research station. Select a landmark to explore a role; not a live run."}</figcaption>
</figure>

<style>
  .research-field { margin: 0; min-width: 0; }
  .research-field__explorer { position: relative; min-inline-size: 0; margin: 0; padding: 0; border: 0; }
  .research-field__sr-only, .research-field__choice {
    position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  .research-field__landscape { position: relative; isolation: isolate; }
  .research-field__landscape img { display: block; width: 100%; height: auto; image-rendering: pixelated; }
  .research-field__station {
    position: absolute; left: var(--station-x); top: var(--station-y);
    display: grid; place-items: center; width: 44px; height: 44px;
    transform: translate(-50%, -50%); cursor: pointer; touch-action: manipulation;
  }
  .research-field__station span {
    display: grid; place-items: center; width: 26px; height: 30px; padding-bottom: 4px;
    color: #f7dfa0; background: #183951; font: 700 12px var(--mono);
    clip-path: polygon(4px 0,22px 0,22px 4px,26px 4px,26px 22px,18px 22px,13px 28px,8px 22px,0 22px,0 4px,4px 4px);
    transition: transform 160ms steps(2, end), background-color 160ms;
  }
  .research-field__station:hover span { transform: translateY(-4px); background: #386484; }
  .research-field__roles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-bottom: 1px solid var(--line); }
  .research-field__node {
    display: grid; gap: 3px; padding: 10px 2px 12px; text-align: center;
    color: var(--muted); border-bottom: 2px solid transparent;
    cursor: pointer; user-select: none; touch-action: manipulation;
  }
  .research-field__node span { font-size: 11px; font-weight: 600; }
  .research-field__node small { font-size: 9px; }
  .research-field__node:hover { color: var(--blue); }
  .research-field__choice[value="manager"]:checked ~ .research-field__landscape [data-role="manager"] span,
  .research-field__choice[value="planner"]:checked ~ .research-field__landscape [data-role="planner"] span,
  .research-field__choice[value="engineer"]:checked ~ .research-field__landscape [data-role="engineer"] span,
  .research-field__choice[value="reviewer"]:checked ~ .research-field__landscape [data-role="reviewer"] span {
    color: #102c46; background: #f7dfa0; transform: translateY(-4px);
  }
  .research-field__choice[value="manager"]:checked ~ .research-field__roles [data-role="manager"],
  .research-field__choice[value="planner"]:checked ~ .research-field__roles [data-role="planner"],
  .research-field__choice[value="engineer"]:checked ~ .research-field__roles [data-role="engineer"],
  .research-field__choice[value="reviewer"]:checked ~ .research-field__roles [data-role="reviewer"] {
    color: var(--ink); border-bottom-color: var(--gold);
  }
  .research-field__choice[value="manager"]:focus-visible ~ .research-field__roles [data-role="manager"],
  .research-field__choice[value="planner"]:focus-visible ~ .research-field__roles [data-role="planner"],
  .research-field__choice[value="engineer"]:focus-visible ~ .research-field__roles [data-role="engineer"],
  .research-field__choice[value="reviewer"]:focus-visible ~ .research-field__roles [data-role="reviewer"] {
    outline: 2px solid var(--blue); outline-offset: 2px;
  }
  .research-field__details { display: grid; }
  /* Overlapping hidden panels keep the scene steady when a role changes. */
  .research-field__detail { grid-area: 1 / 1; min-width: 0; padding: 20px 4px 0; visibility: hidden; }
  .research-field__choice[value="manager"]:checked ~ .research-field__details [data-role="manager"],
  .research-field__choice[value="planner"]:checked ~ .research-field__details [data-role="planner"],
  .research-field__choice[value="engineer"]:checked ~ .research-field__details [data-role="engineer"],
  .research-field__choice[value="reviewer"]:checked ~ .research-field__details [data-role="reviewer"] { visibility: visible; }
  .research-field__detail-heading { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .research-field__index { color: var(--gold-dark); font: 9px var(--mono); white-space: nowrap; }
  .research-field__detail-heading h3 { margin: 0; color: var(--ink); font: 500 25px/1.25 var(--serif); letter-spacing: -.025em; }
  .research-field__action { margin-left: auto; color: var(--blue); font-size: 11px; font-weight: 600; }
  .research-field__detail p { margin: 12px 0 16px; color: var(--ink-2); font-size: 13px; line-height: 1.7; }
  .research-field__detail dl { display: grid; grid-template-columns: auto 1fr; gap: 10px; margin: 0; font-size: 12px; line-height: 1.6; }
  .research-field__detail dt { color: var(--blue); font-weight: 600; }
  .research-field__detail dd { margin: 0; color: var(--ink); overflow-wrap: anywhere; }
  figcaption { margin: 18px auto 0; color: var(--faint); font-size: 10px; text-align: center; text-wrap: pretty; }
  @media (max-width: 480px) {
    .research-field__detail-heading { gap: 9px; }
    .research-field__detail dl { grid-template-columns: 1fr; gap: 3px; }
  }
  @media (prefers-reduced-motion: reduce) { .research-field__station span { transition: none; } }
  @media (forced-colors: active) {
    .research-field__station span { clip-path: none; border: 1px solid CanvasText; }
  }
</style>
