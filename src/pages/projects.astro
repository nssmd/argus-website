---
import SiteLayout from "../layouts/SiteLayout.astro";
import { projectDomains, projects } from "../data/projects";
import { localeFromPath, pathForLocale } from "../i18n";

const locale = localeFromPath(Astro.url.pathname);
const href = (path: string) => pathForLocale(path, locale);
const labels = locale === "zh" ? {
  title: "Projects · Argus AI Team",
  description: "浏览 Argus AI Team 的 Agent runtime、芯片、模型部署和数学研究项目。",
  eyebrow: "Argus AI Team · Projects",
  hero: "从自主 Agent 到芯片、模型与科学研究。",
  lede: "这里集中展示团队已经公开的系统、工程和研究成果。每个项目都直接连接到代码、证据或技术报告。",
  mapEyebrow: "领域地图",
  mapTitle: "选择一个领域，进入它的项目主页。",
  mapBody: "每个领域都有独立的二级主页，集中展示方向、能力、成果和公开仓库。",
  projects: "个项目",
  enter: "进入领域主页",
  teamTitle: "一个团队，一套持续扩展的能力版图。",
  teamBody: "Argus 是长期自主工作的基础运行时；ACE、MiniMax-H3 和数学研究则展示同一套研究与工程方法如何进入不同领域。",
  organization: "访问 Argus AI Team GitHub →",
  startTitle: "想先使用核心 Argus runtime？",
  startBody: "从安装指引开始，选择已有 Agent CLI 作为后端，并完成第一次经过 Reviewer 验收的运行。",
  start: "开始使用 Argus →",
  results: "查看量化成绩 →",
} : {
  title: "Projects · Argus AI Team",
  description: "Explore Argus AI Team projects across agent runtimes, chips, model deployment, and mathematics.",
  eyebrow: "Argus AI Team · Projects",
  hero: "From autonomous agents to chips, models, and scientific research.",
  lede: "This is the shared home for the team's public systems, engineering work, and research. Every project connects directly to code, evidence, or a technical report.",
  mapEyebrow: "Domain map",
  mapTitle: "Choose a field and enter its project home.",
  mapBody: "Each domain has a dedicated second-level home for its direction, capabilities, results, and public repositories.",
  projects: "projects",
  enter: "Enter domain",
  teamTitle: "One team. A continuously expanding capability map.",
  teamBody: "Argus provides the persistent autonomy layer. ACE, MiniMax-H3, and mathematics show how the same research and engineering discipline transfers into distinct domains.",
  organization: "Visit Argus AI Team on GitHub →",
  startTitle: "Want to use the core Argus runtime first?",
  startBody: "Follow the guided installation path, reuse an Agent CLI you already have, and complete a first run that is independently reviewed.",
  start: "Get started with Argus →",
  results: "See measured results →",
};

---

<SiteLayout title={labels.title} description={labels.description}>
  <section class="page-hero compact projects-hero">
    <div class="shell">
      <p class="eyebrow">{labels.eyebrow}</p>
      <h1>{labels.hero}</h1>
      <p class="lede">{labels.lede}</p>
      <div class="hero-actions">
        <a class="button primary" href="https://github.com/Argus-AiTeam" target="_blank" rel="noopener noreferrer">{labels.organization}</a>
        <a class="button" href={href("/get-started/")}>{labels.start}</a>
        <a class="button" href={href("/results/")}>{labels.results}</a>
      </div>
    </div>
  </section>

  <section class="section project-domain-map">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">{labels.mapEyebrow}</p>
        <h2>{labels.mapTitle}</h2>
        <p>{labels.mapBody}</p>
      </div>
      <div class="project-domain-grid">
        {projectDomains.map((domain, index) => {
          const domainProjects = projects.filter((project) => project.category === domain.id);
          return (
            <a class={`project-domain-card project-domain-card--${domain.id}`} href={href(`/projects/${domain.id}/`)}>
              <div class="project-domain-card__top">
                <span>0{index + 1}</span>
                <small>{domain.eyebrow[locale]}</small>
              </div>
              <div class="project-domain-card__copy">
                <h2>{domain.label[locale]}</h2>
                <p>{domain.headline[locale]}</p>
              </div>
              <div class="project-domain-card__projects">
                {domainProjects.map((project) => <span>{project.title}</span>)}
              </div>
              <div class="project-domain-card__foot">
                <span><strong>{String(domainProjects.length).padStart(2, "0")}</strong> {labels.projects}</span>
                <b>{labels.enter}<i aria-hidden="true">→</i></b>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="team-band">
        <div>
          <p class="eyebrow">Argus AI Team</p>
          <h2>{labels.teamTitle}</h2>
          <p>{labels.teamBody}</p>
        </div>
        <a class="button" href="https://github.com/Argus-AiTeam" target="_blank" rel="noopener noreferrer">{labels.organization}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="cta-band">
        <h2>{labels.startTitle}</h2>
        <p>{labels.startBody}</p>
        <a class="button primary" href={href("/get-started/")}>{labels.start}</a>
      </div>
    </div>
  </section>
</SiteLayout>
