---
import SiteLayout from "../layouts/SiteLayout.astro";
import PageHero from "../components/PageHero.astro";
import PixelIllustration from "../components/PixelIllustration";
import { teamMembers } from "../data/team";
import { localeFromPath, pathForLocale } from "../i18n";

const locale = localeFromPath(Astro.url.pathname);
const href = (path: string) => pathForLocale(path, locale);
const copy = locale === "zh" ? {
  title: "Contact Us · Argus AI Team",
  description: "通过 Argus AI Team 成员公开的 GitHub Profile 和邮箱联系我们。",
  eyebrow: "Argus AI Team · Contact",
  hero: "认识构建 Argus 的成员。",
  lede: "选择一位成员，通过 GitHub 或邮箱与我们联系。",
  organization: "访问团队 GitHub ↗",
  project: "查看团队项目 →",
  membersTitle: "团队成员",
  membersBody: "访问成员的 GitHub，了解他们的工作并取得联系。",
  publicEmail: "公开邮箱",
  noEmail: "通过 GitHub 联系",
  github: "打开 GitHub Profile",
  communityEyebrow: "Community",
  communityTitle: "加入 Argus 微信社区",
  communityBody: "扫描二维码加入社区，交流 Argus 使用、研究项目与工程实践。当前请加入 Group 2；如果二维码已经过期，请在 GitHub 提交 Issue 获取最新入口。",
  communityAlt: "Argus 微信社区 Group 2 二维码",
  communityIssue: "二维码失效？前往 GitHub Issue ↗",
  contactTitle: "关于项目、合作或问题反馈",
  contactBody: "桌面安装包与开发预览问题请提交到 lbx154/Argus；官方源码问题请提交到 microsoft/ArgusAgent。也可以直接联系团队成员，分享诊断时不要附带邀请 Key 或账号凭据。",
  issues: "桌面版与开发预览问题 ↗",
  sourceIssues: "官方源码问题 ↗",
  start: "开始使用 Argus →",
} : {
  title: "Contact Us · Argus AI Team",
  description: "Contact Argus AI Team members through their public GitHub profiles and email addresses.",
  eyebrow: "Argus AI Team · Contact",
  hero: "Meet the people building Argus.",
  lede: "Choose a team member and reach us through GitHub or email.",
  organization: "Visit the team on GitHub ↗",
  project: "Explore team projects →",
  membersTitle: "Team members",
  membersBody: "Visit a member's GitHub profile to explore their work and get in touch.",
  publicEmail: "Public email",
  noEmail: "Contact through GitHub",
  github: "Open GitHub profile",
  communityEyebrow: "Community",
  communityTitle: "Join the Argus WeChat community",
  communityBody: "Scan the QR code to discuss Argus usage, research projects, and engineering practice. Join Group 2; if the code has expired, open a GitHub Issue for the latest invitation.",
  communityAlt: "QR code for Argus WeChat Community Group 2",
  communityIssue: "QR code expired? Open a GitHub Issue ↗",
  contactTitle: "Projects, collaboration, and support",
  contactBody: "Report desktop-package and development-preview issues to lbx154/Argus, and official-source issues to microsoft/ArgusAgent. You can also contact a team member directly. Do not attach invitation Keys or account credentials to diagnostics.",
  issues: "Desktop and preview issues ↗",
  sourceIssues: "Official source issues ↗",
  start: "Get started with Argus →",
};
---

<SiteLayout title={copy.title} description={copy.description}>
  <PageHero scene="research-campus" class="contact-hero">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.hero}</h1>
      <p class="lede">{copy.lede}</p>
      <div class="hero-actions">
        <a class="button primary" href="https://github.com/Argus-AiTeam" target="_blank" rel="noopener noreferrer">{copy.organization}</a>
        <a class="button" href={href("/projects/")}>{copy.project}</a>
      </div>
  </PageHero>

  <section class="section tight">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">People</p>
        <h2>{copy.membersTitle}</h2>
        <p>{copy.membersBody}</p>
      </div>
      <div class="team-member-grid">
        {teamMembers.map((member, index) => (
          <>
          <article class="team-member-card">
            <a class="team-member-card__identity" href={member.profile} target="_blank" rel="noopener noreferrer">
              <img src={member.avatar} width="72" height="72" loading="lazy" alt="" />
              <div>
                <h3>@{member.login}</h3>
                <span>github.com/{member.login}</span>
              </div>
            </a>
            <div class="team-member-card__contact">
              {member.emails.length > 0 ? member.emails.map((email) => (
                <a href={`mailto:${email}`}><span>{copy.publicEmail}</span><strong>{email}</strong></a>
              )) : <span class="team-member-card__no-email">{copy.noEmail}</span>}
            </div>
            <a class="team-member-card__github" href={member.profile} target="_blank" rel="noopener noreferrer">
              <span>{copy.github}</span><i aria-hidden="true">↗</i>
            </a>
          </article>
          {index === 2 && <PixelIllustration scene="memory-garden" />}
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="section surface">
    <div class="shell">
      <div class="wechat-community">
        <div class="wechat-community__copy">
          <p class="eyebrow">{copy.communityEyebrow}</p>
          <h2>{copy.communityTitle}</h2>
          <p>{copy.communityBody}</p>
          <a class="button" href="https://github.com/microsoft/ArgusAgent/issues" target="_blank" rel="noopener noreferrer">{copy.communityIssue}</a>
          <PixelIllustration scene="relay-bridge" />
        </div>
        <a class="wechat-community__qr" href="/assets/argus-wechat-group-2.jpg?v=5fd55d09" target="_blank" rel="noopener noreferrer">
          <img src="/assets/argus-wechat-group-2.jpg?v=5fd55d09" width="939" height="1455" loading="lazy" alt={copy.communityAlt} />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="cta-band">
        <h2>{copy.contactTitle}</h2>
        <p>{copy.contactBody}</p>
        <div class="hero-actions">
          <a class="button primary" href="https://github.com/lbx154/Argus/issues" target="_blank" rel="noopener noreferrer">{copy.issues}</a>
          <a class="button" href="https://github.com/microsoft/ArgusAgent/issues" target="_blank" rel="noopener noreferrer">{copy.sourceIssues}</a>
          <a class="button" href={href("/get-started/")}>{copy.start}</a>
        </div>
        <PixelIllustration scene="launch-dock" />
      </div>
    </div>
  </section>
</SiteLayout>
